---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../layouts/PageBanner.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import { requestData } from '../../lib/utils';
const ID = '6a15767a21dbfc72fd5082d2';
export function getStaticPaths(){return requestData('service').map((item:any)=>({params:{id:String(item.id)}}));}
const list = requestData('service',{data_type:'list',limit:-1,sort:'sortDesc'});
const item=requestData('service',{data_type:'show',id:Astro.params.id}).info||{};
const category = requestData('category', { data_type: 'show', id: item.category_id || ID }).info || {};
const root = item.category_id === ID ? category : requestData('category', { data_type: 'show', id: ID }).info || {};
const serviceLink = (entry:any) => `/service/${entry.id}/?category_id=${encodeURIComponent(entry.category_id || ID)}`;
---
<BaseLayout tdk={{title:`${item.title || '服务'} - 赛诺邦格`, description: item.intro || ''}}>
  <PageBanner bannerImage={category.image_intro || root.image_intro || '/images/bg7.png'} titleZh="服务" titleEn="Service" crumbs={[{name:'服务',link:'/service/'},{name:item.title || '详情'}]} />
  <div class="project_section"><img src="/images/bg7.png" class="pro_bg1" alt="" /><div class="block"><div class="proj_bg"></div><div class="inner clearfix">
    <aside class="left"><span class="left_caption sp">服务</span><ul class="tech_list">{list.map((entry:any)=><li class={`tech_item${String(entry.id)===String(item.id)?' tech_current':''}`}><a href={serviceLink(entry)} class="tech_link">{entry.title}</a></li>)}{!list.length && <li class="jzt2-empty">暂无服务内容</li>}</ul><div class="pc1"><TechSidebar /></div></aside>
    <section class="right right1">{item.id ? <><span class="tech_title"><h1>{item.title}</h1></span><div class="tech_box service_content jzt2-richtext" set:html={item.details || item.content || item.intro || ''}></div></> : <div class="jzt2-empty">暂无服务内容</div>}</section>
    <div class="sp"><TechSidebar /></div><div class="blank50"></div>
  </div></div></div>
</BaseLayout>

<style>
  .tech_title h1 { font-size: inherit; font-weight: inherit; }
  .service_content :global(img) { max-width: 100%; height: auto; }
</style>
