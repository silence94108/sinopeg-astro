---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../layouts/PageBanner.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import { requestData } from '../../lib/utils';

const ID = '6a15767a21dbfc72fd5082d2';
const list = requestData('service', { data_type: 'list', limit: -1, sort: 'sortDesc' });
const current = list[0] || {};
const info = requestData('category', { data_type: 'show', id: ID }).info || {};
const serviceLink = (item:any) => `/service/${item.id}/?category_id=${encodeURIComponent(item.category_id || ID)}`;
const tdk = {
  title: '聚乙二醇衍生物_核苷酸类药物中间体_嵌段共聚物-厦门赛诺邦格生物科技股份有限公司',
  keywords: '聚乙二醇衍生物,核苷酸类药物中间体,嵌段共聚物',
  description: '厦门赛诺邦格提供以下产品的定制合成服务：多分散聚乙二醇衍生物、单分散聚乙二醇衍生物、核苷酸药物中间体、嵌段共聚物等。'
};
---
<BaseLayout tdk={tdk}>
  <PageBanner bannerImage={info.image_intro || '/images/bg7.png'} titleZh="服务" titleEn="Service" crumbs={[{ name: '服务', link: '/service/' }, ...(current.title ? [{ name: current.title }] : [])]} />
  <div class="project_section">
    <img src="/images/bg7.png" class="pro_bg1" alt="" />
    <div class="block"><div class="proj_bg"></div><div class="inner clearfix">
      <aside class="left">
        <span class="left_caption sp">服务</span>
        <ul class="tech_list">
          {list.map((item:any) => <li class={`tech_item${String(item.id) === String(current.id) ? ' tech_current' : ''}`}><a href={serviceLink(item)} class="tech_link">{item.title}</a></li>)}
          {!list.length && <li class="jzt2-empty">暂无服务内容</li>}
        </ul>
        <div class="pc1"><TechSidebar /></div>
      </aside>
      <section class="right right1">
        {current.id ? <><span class="tech_title"><h1>{current.title}</h1></span><div class="tech_box service_content jzt2-richtext" set:html={current.details || current.content || current.intro || ''}></div></> : <div class="jzt2-empty">暂无服务内容</div>}
      </section>
      <div class="sp"><TechSidebar /></div><div class="blank50"></div>
    </div></div>
  </div>
</BaseLayout>

<style>
  .tech_title h1 { font-size: inherit; font-weight: inherit; }
  .service_content :global(img) { max-width: 100%; height: auto; }
</style>
