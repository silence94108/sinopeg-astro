---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageBanner from '../../layouts/PageBanner.astro'; import { requestData } from '../../lib/utils';
const ID='6a15767a21dbfc72fd5082d2'; const info=requestData('category',{data_type:'show',id:ID}).info||{}; const list=requestData('service',{data_type:'list',limit:-1,sort:'sortDesc'});
---
<BaseLayout tdk={{title:'服务 - 赛诺邦格'}}><PageBanner bannerImage={info.image_intro || '/images/bg7.png'} titleZh="服务" titleEn="Service" crumbs={[{name:'服务'}]} /><div class="project_section"><div class="block"><div class="inner clearfix"><section class="right right1"><div class="right_tui_title">服务</div>{list.map((item:any)=><article class="service_block"><h2 class="service_title">{item.title}</h2><div class="service_area jzt2-richtext" set:html={item.details || item.intro || ''}></div></article>)}</section></div></div></div></BaseLayout>
