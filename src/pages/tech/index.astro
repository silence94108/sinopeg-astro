---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../layouts/PageBanner.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import { requestData, timeStamp2String } from '../../lib/utils';

const ROOT_CATEGORY_ID = '6a1576ad55a9703f216255b1';
const requestedId = Astro.url.searchParams.get('id') || '';
const requestedCategoryId = Astro.url.searchParams.get('category_id') || '';
const list = requestData('technology', {
  data_type: 'list',
  limit: -1,
  sort: 'sortDesc',
  ...(requestedCategoryId ? { category_id: requestedCategoryId } : {}),
});
const current = list.find((item: any) => String(item.id) === requestedId) || list[0] || {};
const categoryId = requestedCategoryId || current.category_id || ROOT_CATEGORY_ID;
const category = requestData('category', { data_type: 'show', id: categoryId }).info || {};
const rootCategory = requestData('category', { data_type: 'show', id: ROOT_CATEGORY_ID }).info || {};
const bannerImage = category.image_intro || rootCategory.image_intro || '/images/bg7.png';
const detailHtml = current.details || current.content || current.intro || '';
const formatDate = (value: any) => value ? timeStamp2String(value, 'Y/m/d') : '';
const detailLink = (item: any) => `/tech/${item.id}/?category_id=${encodeURIComponent(item.category_id || categoryId)}`;
---
<BaseLayout tdk={{ title: `${current.title || '技术'} - 赛诺邦格`, description: current.intro || '' }}>
  <PageBanner bannerImage={bannerImage} titleZh="技术" titleEn="Technology" crumbs={[{ name: '技术', link: '/tech/' }, ...(current.title ? [{ name: current.title }] : [])]} />
  <div class="project_section">
    <img src="/images/bg7.png" class="pro_bg1" alt="" />
    <div class="block"><div class="proj_bg"></div><div class="inner clearfix">
      <aside class="left">
        <span class="left_caption sp">技术</span>
          <ul class="tech_list">
          {list.map((item: any) => <li class={`tech_item${String(item.id) === String(current.id) ? ' tech_current' : ''}`}><a href={detailLink(item)} class="tech_link">{item.title}</a></li>)}
          {!list.length && <li class="jzt2-empty">暂无技术内容</li>}
          </ul>
          <div class="pc1"><TechSidebar /></div>
        </aside>
      <section class="right right1">
        {current.id ? <><div class="tech_title"><h1>{current.title}</h1>{formatDate(current.create_time) && <span>{formatDate(current.create_time)}</span>}</div><div class="tech_box jzt2-richtext" set:html={detailHtml}></div></> : <div class="jzt2-empty">暂无技术内容</div>}
      </section>
      <div class="sp"><TechSidebar /></div>
      <div class="blank50"></div>
    </div></div>
  </div>
</BaseLayout>

<style>
  .tech_title { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
  .tech_title h1 { font-size: inherit; font-weight: inherit; }
  .tech_title > span { flex: 0 0 auto; font-size: 16px; color: #999; }
  .tech_box img { max-width: 100%; height: auto; }
  @media (max-width: 767px) { .tech_title { display: block; } .tech_title > span { margin-top: 8px; } }
</style>
