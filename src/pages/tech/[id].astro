---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../layouts/PageBanner.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import { requestData, timeStamp2String } from '../../lib/utils';

const ROOT_CATEGORY_ID = '6a1576ad55a9703f216255b1';
export function getStaticPaths() {
  const technology = requestData('technology');
  return technology.map((item: any) => ({ params: { id: item.id } }));
}

const item = requestData('technology', { data_type: 'show', id: Astro.params.id }).info || {};
const list = requestData('technology');
const categoryId = item.category_id || ROOT_CATEGORY_ID;
const category = requestData('category', { data_type: 'show', id: categoryId }).info || {};
const rootCategory = requestData('category', { data_type: 'show', id: ROOT_CATEGORY_ID }).info || {};
const bannerImage = category.image_intro || rootCategory.image_intro || '/images/bg7.png';
const detailHtml = item.details || item.content || item.intro || '';
const dateText = item.create_time ? timeStamp2String(item.create_time, 'Y/m/d') : '';
const detailLink = (entry: any) => `/tech/${entry.id}/?category_id=${encodeURIComponent(entry.category_id || categoryId)}`;
---
<BaseLayout tdk={{ title: `${item.title || '技术'} - 赛诺邦格`, description: item.intro || '' }}>
  <PageBanner
    bannerImage={bannerImage}
    titleZh="技术"
    titleEn="Technology"
    crumbs={[{ name: '技术', link: '/tech/' }, { name: item.title || '详情' }]}
  />
  <div class="project_section">
    <img src="/images/bg7.png" class="pro_bg1" alt="" />
    <div class="block">
      <div class="proj_bg"></div>
      <div class="inner clearfix">
        <aside class="left">
          <span class="left_caption sp">技术</span>
          <ul class="tech_list">
            {list.map((entry: any) => (
              <li class={`tech_item${String(entry.id) === String(item.id) ? ' tech_current' : ''}`}>
                <a href={detailLink(entry)} class="tech_link">{entry.title}</a>
              </li>
            ))}
            {!list.length && <li class="jzt2-empty">暂无技术内容</li>}
          </ul>
          <div class="pc1"><TechSidebar /></div>
        </aside>
        <section class="right right1">
          {item.id ? (
            <>
              <div class="tech_title">
                <h1>{item.title}</h1>
                {dateText && <span>{dateText}</span>}
              </div>
              <div class="tech_box jzt2-richtext" set:html={detailHtml}></div>
            </>
          ) : <div class="jzt2-empty">暂无技术内容</div>}
        </section>
        <div class="sp"><TechSidebar /></div>
        <div class="blank50"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tech_title { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
  .tech_title h1 { font-size: inherit; font-weight: inherit; }
  .tech_title > span { flex: 0 0 auto; font-size: 16px; color: #999; }
  .tech_box img { max-width: 100%; height: auto; }
  @media (max-width: 767px) {
    .tech_title { display: block; }
    .tech_title > span { margin-top: 8px; }
  }
</style>
