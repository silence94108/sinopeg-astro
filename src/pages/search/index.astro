---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requestData } from '../../lib/utils';
const siteInfo = requestData('site') || {};
const tdk = {
  title: `搜索 - ${siteInfo.title || '厦门赛诺邦格生物科技|化合物定制合成_聚乙二醇衍生物/脂质/LNP供应商'}`,
  keywords: siteInfo.keywords || '',
  description: siteInfo.description || ''
};
---
<BaseLayout tdk={tdk}>
  <section class="search">
    <div class="inner">
      <span class="search_title">搜索</span>
      <div style="position: relative;">
        <form class="search_form clearfix" data-search-form>
          <span class="search_form_text">站内搜索：</span>
          <input
            type="text"
            autocomplete="off"
            placeholder="关键词搜索"
            class="search_form_input"
            data-search-key
          />
          <input type="button" value="搜索" class="search_form_btu" data-search-btn />
        </form>
        <div class="lki" style="position: absolute; left: 96px; top: 120%;">
          <ul
            data-search-suggest
            style="display: none; background: #ECECEC; border-radius: 10px; padding: 15px;"
          ></ul>
        </div>
      </div>
      <span class="serach_caption" data-search-caption style="display: none;"></span>
      <ul class="search_list clearfix" data-search-results></ul>
      <div class="fan" data-search-pagination style="display: none;"></div>
    </div>
  </section>
</BaseLayout>

<script>
  type SearchItem = {
    id: string;
    category_id: string;
    title: string;
    casNo: string;
    productNo: string;
    abbrName: string;
    searchAttribute: string;
    bg_img: string;
    keywords: string;
    webKey: string;
    webDesc: string;
    intro: string;
    searchText: string;
  };

  // 与参考站 jzt_common.js getDefaultProductSearchFields 一致
  const SEARCH_FIELDS = ['title', 'casNo', 'productNo', 'abbrName', 'keywords', 'webKey', 'webDesc', 'intro', 'searchText'];
  // 与参考站 jzt_common.js getProductSearchSuggestions 一致
  const SUGGEST_FIELDS = ['title', 'casNo', 'productNo', 'abbrName', 'keywords', 'intro'];
  const SEARCH_PAGE_SIZE = 16;
  const isMobile = /Android|webOS|iPhone|iPod|BlackBerry/i.test(navigator.userAgent);

  const input = document.querySelector<HTMLInputElement>('[data-search-key]');
  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const button = document.querySelector<HTMLInputElement>('[data-search-btn]');
  const suggestList = document.querySelector<HTMLUListElement>('[data-search-suggest]');
  const caption = document.querySelector<HTMLElement>('[data-search-caption]');
  const results = document.querySelector<HTMLUListElement>('[data-search-results]');
  const pagination = document.querySelector<HTMLElement>('[data-search-pagination]');

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char] || char);

  const normalizePage = (value: unknown) => {
    const page = Number(value);
    return Number.isFinite(page) && page > 0 ? Math.floor(page) : 1;
  };

  // 与参考站 getKeywords 一致：关键词空时回退 webKey，按中英文逗号/顿号/分号切分去重
  const getKeywords = (item: SearchItem) => {
    const keywordText = item.keywords || item.webKey || '';
    return Array.from(new Set(String(keywordText).split(/[,，、;；]+/).map((text) => text.trim()).filter(Boolean)));
  };

  // 全量索引：搜索结果和联想词共用，只 fetch 一次
  let indexItems: SearchItem[] = [];
  let indexPromise: Promise<SearchItem[]> | null = null;
  const loadIndex = () => {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json').then((response) => {
        if (!response.ok) throw new Error(String(response.status));
        return response.json() as Promise<SearchItem[]>;
      });
      indexPromise.catch(() => { indexPromise = null; });
    }
    return indexPromise;
  };

  let searchedKeyword = '';
  let currentPage = 1;
  let loading = false;
  let hasSearched = false;
  let resultItems: SearchItem[] = [];
  let totalCount = 0;
  let lastPage = 1;

  const readUrlState = () => {
    const params = new URLSearchParams(window.location.search);
    searchedKeyword = params.get('key')?.trim() || '';
    currentPage = normalizePage(params.get('page'));
    hasSearched = Boolean(searchedKeyword);
    if (input) input.value = searchedKeyword;
  };

  // 与参考站 buildSearchUrl 一致：第 1 页不带 page 参数
  const buildSearchUrl = (page: number, keyword: string) => {
    const params = new URLSearchParams();
    if (keyword) params.set('key', keyword);
    if (normalizePage(page) > 1) params.set('page', String(normalizePage(page)));
    const query = params.toString();
    return `/search/${query ? '?' + query : ''}`;
  };

  // 与参考站 paginationApp pageHref 一致：分页条链接始终带 page
  const pageHref = (page: number) => {
    const params = new URLSearchParams();
    params.set('key', searchedKeyword);
    params.set('page', String(page));
    return `/search/?${params.toString()}`;
  };

  const cardHtml = (item: SearchItem) => {
    const categoryId = String(item.category_id || '').split(',')[0];
    const image = item.bg_img || '/images/pro1.png';
    // 参考站桌面端最多 5 个关键词标签，移动端只取第一个
    const tags = (isMobile ? getKeywords(item).slice(0, 1) : getKeywords(item).slice(0, 5));
    const guanHtml = tags.length
      ? `<div class="proex_guan"><img src="/images/ico7.png" alt="关键词" /><span class="proex_guan_title">关键词：</span>${tags.map((tag) => `<span class="proex_guan_text">${escapeHtml(tag)}</span>`).join('')}</div>`
      : '';
    return `<li class="search_item" style="height: 357px;">
      <a href="/product/${encodeURIComponent(item.id)}/?category_id=${encodeURIComponent(categoryId)}" class="search_link">
        <div class="search_photo"><img src="${escapeHtml(image)}" alt="${escapeHtml(item.title)}" loading="lazy" /></div>
        <div class="search_box">
          <span class="search_name">${escapeHtml(item.title)}</span>
          <span class="search_text"><text>简称：</text><font>${escapeHtml(item.abbrName || '-')}</font></span>
          <span class="search_text"><text>cas#：</text><font>${escapeHtml(item.casNo || '-')}</font></span>
          <span class="search_text"><text>属性：</text><font>${escapeHtml(String(item.searchAttribute || '').trim())}</font></span>
          ${guanHtml}
        </div>
      </a>
    </li>`;
  };

  const renderCaption = () => {
    if (!caption) return;
    if (!hasSearched) {
      caption.style.display = 'none';
      return;
    }
    caption.style.display = '';
    caption.innerHTML = loading
      ? `"${escapeHtml(searchedKeyword)}" 的搜索结果 : <font>搜索中...</font>`
      : `"${escapeHtml(searchedKeyword)}" 的搜索结果 : <font>${totalCount}</font> 条符合条件的信息`;
  };

  const renderResults = () => {
    if (!results) return;
    if (loading) {
      results.innerHTML = '<li style="width: 100%; padding: 40px 0; text-align: center; color: #999999;">加载中...</li>';
      return;
    }
    if (hasSearched && !resultItems.length) {
      results.innerHTML = '<li style="width: 100%; padding: 40px 0; text-align: center; color: #999999;">暂无该类图文！</li>';
      return;
    }
    results.innerHTML = resultItems.map(cardHtml).join('');
  };

  const renderPagination = () => {
    if (!pagination) return;
    if (loading || lastPage <= 1) {
      pagination.style.display = 'none';
      return;
    }
    const current = Math.min(currentPage, lastPage);
    const visibleCount = Math.min(5, lastPage);
    let start = Math.max(1, current - Math.floor(visibleCount / 2));
    const end = Math.min(lastPage, start + visibleCount - 1);
    start = Math.max(1, end - visibleCount + 1);
    let html = current > 1 ? `<a href="${pageHref(current - 1)}" data-page="${current - 1}">上一页</a>` : '<a>上一页</a>';
    for (let page = start; page <= end; page += 1) {
      html += page === current
        ? `<a class="select">${page}</a>`
        : `<a href="${pageHref(page)}" data-page="${page}">${page}</a>`;
    }
    html += current < lastPage ? `<a href="${pageHref(current + 1)}" data-page="${current + 1}">下一页</a>` : '<a>下一页</a>';
    html += `当前${current}/${lastPage}页&nbsp;&nbsp;&nbsp;共${lastPage}页`;
    pagination.innerHTML = html;
    pagination.style.display = '';
  };

  const renderPage = () => {
    const keyword = searchedKeyword.toLowerCase();
    const matched = hasSearched
      ? indexItems.filter((item) => SEARCH_FIELDS.some((field) => String(item[field] || '').trim().toLowerCase().includes(keyword)))
      : [];
    totalCount = matched.length;
    lastPage = Math.max(1, Math.ceil(totalCount / SEARCH_PAGE_SIZE));
    currentPage = Math.min(currentPage, lastPage);
    resultItems = matched.slice((currentPage - 1) * SEARCH_PAGE_SIZE, currentPage * SEARCH_PAGE_SIZE);
    renderCaption();
    renderResults();
    renderPagination();
  };

  // 联想词：与参考站 getProductSearchSuggestions 一致，收集命中的整段字段值，去重取前 10
  let suggestions: string[] = [];
  let suggestionsVisible = false;
  let suggestToken = 0;

  const renderSuggestions = () => {
    if (!suggestList) return;
    if (!suggestionsVisible || !suggestions.length) {
      suggestList.style.display = 'none';
      return;
    }
    suggestList.innerHTML = suggestions.map((item) => `<li style="font-size: 14px; cursor: pointer;">${escapeHtml(item)}</li>`).join('');
    suggestList.style.display = 'block';
  };

  const updateSuggestions = async () => {
    const value = input?.value.trim() || '';
    if (!value) {
      suggestions = [];
      suggestionsVisible = false;
      renderSuggestions();
      return;
    }
    const token = ++suggestToken;
    try {
      await loadIndex();
    } catch {
      return;
    }
    if (token !== suggestToken) return;
    const normalized = value.toLowerCase();
    const collected: string[] = [];
    indexItems.forEach((item) => {
      SUGGEST_FIELDS.forEach((field) => {
        const text = String(item[field] || '').trim();
        if (text && text.toLowerCase().includes(normalized)) collected.push(text);
      });
    });
    suggestions = Array.from(new Set(collected)).slice(0, 10);
    suggestionsVisible = suggestions.length > 0;
    renderSuggestions();
  };

  const hideSuggestions = () => {
    // 延迟让 li 的 mousedown 先触发，与参考站一致
    window.setTimeout(() => {
      suggestionsVisible = false;
      renderSuggestions();
    }, 120);
  };

  const selectSuggestion = (value: string) => {
    if (input) input.value = value || '';
    suggestionsVisible = false;
    renderSuggestions();
  };

  const doSearch = () => {
    const value = input?.value.trim() || '';
    if (!value) {
      alert('请输入查询的关键词');
      return;
    }
    window.location.href = buildSearchUrl(1, value);
  };

  // 无刷新翻页，与参考站 paginationApp pushState 行为一致
  const changePage = (page: number) => {
    const nextPage = Math.min(normalizePage(page), lastPage);
    if (nextPage === currentPage) return;
    window.history.pushState(null, '', pageHref(nextPage));
    currentPage = nextPage;
    renderPage();
  };

  const init = async () => {
    readUrlState();
    if (!hasSearched) {
      renderCaption();
      return;
    }
    loading = true;
    renderCaption();
    renderResults();
    try {
      indexItems = await loadIndex();
    } catch {
      loading = false;
      if (caption) {
        caption.style.display = '';
        caption.textContent = '搜索数据加载失败，请稍后重试';
      }
      renderResults();
      return;
    }
    loading = false;
    renderPage();
  };

  input?.addEventListener('input', updateSuggestions);
  input?.addEventListener('focus', updateSuggestions);
  input?.addEventListener('blur', hideSuggestions);
  suggestList?.addEventListener('mousedown', (event) => {
    const target = event.target as HTMLElement | null;
    const index = target ? Array.prototype.indexOf.call(suggestList.children, target.closest('li')) : -1;
    if (index < 0 || !suggestions[index]) return;
    event.preventDefault();
    selectSuggestion(suggestions[index]);
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    doSearch();
  });
  button?.addEventListener('click', doSearch);
  pagination?.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLElement>('a[data-page]');
    if (!link) return;
    event.preventDefault();
    changePage(Number(link.dataset.page));
  });
  window.addEventListener('popstate', () => {
    readUrlState();
    renderPage();
  });

  void init();
</script>
