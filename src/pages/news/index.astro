---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../layouts/PageBanner.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import { requestData, timeStamp2String } from '../../lib/utils';

const tdk = {
  title: '索马鲁肽中间体_索马鲁肽侧链_高分子定制合成-厦门赛诺邦格生物科技股份有限公司',
  keywords: '索马鲁肽中间体,索马鲁肽侧链,高分子定制合成',
  description: '厦门赛诺邦格提供索马鲁肽中间体、索马鲁肽侧链、高分子定制合成等产品服务，并实时更新相关的产品知识以及行业资讯内容。'
}

const NEWS_PARENT_ID = '6a180222b3bb1862a238ca68';
const categories = requestData('category', {
  data_type: 'list',
  limit: -1,
  sort: 'sortDesc',
  type: 'content',
  category_id: NEWS_PARENT_ID,
  list_type: 'children'
});
const categoryId = Astro.url.searchParams.get('category_id') || String(categories[0]?.id || '');
const sort = (Astro.url.searchParams.get('sort') as any) || 'sortDesc';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const allNews = requestData('news', { data_type: 'list', limit: -1, sort } as any).map((item: any) => ({
  id: item.id,
  title: item.title,
  intro: item.intro,
  desc: item.desc,
  bg_img: item.bg_img,
  image_intro: item.image_intro,
  create_time: item.create_time,
  category_id: item.category_id,
  sort: item.sort
}));
const filteredNews = categoryId
  ? allNews.filter((item: any) => String(item.category_id || '').split(',').includes(categoryId))
  : allNews;
const result = { data: filteredNews.slice((page - 1) * 10, page * 10), last_page: Math.max(1, Math.ceil(filteredNews.length / 10)) };
const banner = requestData('category', { data_type: 'show', id: NEWS_PARENT_ID }).info?.image_intro || '/images/bg7.png';
const pageLink = (p: number) => `/news/?page=${p}${categoryId ? `&category_id=${encodeURIComponent(categoryId)}` : ''}&sort=${sort}`;
const newsLink = (item: any) => `/news/${item.id}/?category_id=${encodeURIComponent(item.category_id || categoryId)}&sort=${sort}`;
const imageFor = (item: any) => item.bg_img || item.image_intro || '/images/news1.png';
const dateFor = (item: any) => timeStamp2String(item.create_time, 'Y-m-d');
---

<BaseLayout tdk={tdk}>
  <PageBanner bannerImage={banner} titleZh="新闻" titleEn="News" crumbs={[{ name: '新闻' }]} />
  <div class="project_section">
    <img src="/images/bg7.png" class="pro_bg1" alt="" />
    <div class="block">
      <div class="proj_bg"></div>
      <div class="inner clearfix">
        <aside class="left">
          <span class="left_caption sp">新闻</span>
          <ul class="tech_list">
            {categories.map((item: any) => (
              <li data-category-id={item.id} class={`tech_item${String(categoryId) === String(item.id) ? ' tech_current' : ''}`}>
                <a href={`/news/?category_id=${encodeURIComponent(item.id)}&sort=${sort}`} class="tech_link">{item.title}</a>
              </li>
            ))}
            {!categories.length && <li class="jzt2-empty">暂无新闻分类</li>}
          </ul>
          <div class="pc1"><TechSidebar /></div>
        </aside>

        <section class="right right1">
          <ul class="news_list pc">
            {result.data.map((item: any) => (
              <li class="news_item">
                <a href={newsLink(item)} class="news_link">
                  <div class="news_box">
                    <span class="news_title"><h2>{item.title}</h2></span>
                    <span class="news_text">{item.intro || item.desc || ''}</span>
                    <span class="news_more">查看更多</span>
                  </div>
                  <div class="news_photo">
                    <img src={imageFor(item)} alt={item.title} loading="lazy" />
                  </div>
                </a>
              </li>
            ))}
            {!result.data.length && <li class="jzt2-empty">暂无新闻内容</li>}
          </ul>

          <ul class="news_list news_sp">
            {result.data.map((item: any) => (
              <li class="news_item">
                <a href={newsLink(item)} class="news_link">
                  <div class="news_box">
                    <span class="news_time">{dateFor(item)}</span>
                    <span class="news_title"><h2>{item.title}</h2></span>
                    <span class="news_text">{item.intro || item.desc || ''}</span>
                    <span class="news_more">查看更多</span>
                  </div>
                  <div class="news_photo">
                    <img src={imageFor(item)} alt={item.title} loading="lazy" />
                  </div>
                </a>
              </li>
            ))}
            {!result.data.length && <li class="jzt2-empty">暂无新闻内容</li>}
          </ul>

          {result.last_page > 1 && (
            <nav class="fan" aria-label="新闻分页">
              {page > 1 ? <a href={pageLink(page - 1)}>上一页</a> : <a>上一页</a>}
              {(() => {
                const visibleCount = Math.min(5, result.last_page);
                const end = Math.min(result.last_page, Math.max(1, page - Math.floor(visibleCount / 2)) + visibleCount - 1);
                const start = Math.max(1, end - visibleCount + 1);
                return Array.from({ length: end - start + 1 }, (_, i) => start + i).map((p) => (
                <a href={pageLink(p)} class={p === page ? 'select' : undefined} aria-current={p === page ? 'page' : undefined}>{p}</a>
                ));
              })()}
              {page < result.last_page ? <a href={pageLink(page + 1)}>下一页</a> : <a>下一页</a>}
              <span>当前{Math.min(page, result.last_page)}/{result.last_page}页&nbsp;&nbsp;&nbsp;共{result.last_page}页</span>
            </nav>
          )}
        </section>

        <div class="sp"><TechSidebar /></div>
        <div class="blank50"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ allNews }}>
  const pageSize = 10;
  const params = new URLSearchParams(window.location.search);
  const categoryItems = document.querySelectorAll('.tech_item[data-category-id]');
  const categoryParam = params.get('category_id') || categoryItems[0]?.dataset.categoryId || '';
  const sortParam = params.get('sort') || 'sortDesc';
  let currentPage = Math.max(1, Number(params.get('page') || 1));
  const desktopList = document.querySelector('.news_list.pc');
  const mobileList = document.querySelector('.news_list.news_sp');
  const pagination = document.querySelector('.fan');
  const formatDate = (value) => {
    const raw = String(value || '');
    const date = /^\d+$/.test(raw) ? new Date(Number(raw)) : new Date(raw.replace(/-/g, '/'));
    if (Number.isNaN(date.getTime())) return '';
    return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-');
  };

  const imageFor = (item) => item.bg_img || item.image_intro || '/images/news1.png';
  const categoryMatch = (item, categoryId) => String(item.category_id || '').split(',').includes(categoryId);
  const sortedNews = [...allNews].sort((a, b) => {
    const left = Number(a.sort || 0);
    const right = Number(b.sort || 0);
    return sortParam === 'sortAsc' ? left - right : right - left;
  });

  function createNewsItem(item, mobile) {
    const li = document.createElement('li');
    li.className = 'news_item';
    const link = document.createElement('a');
    link.className = 'news_link';
    link.href = `/news/${item.id}/?category_id=${encodeURIComponent(item.category_id || '')}&sort=${encodeURIComponent(sortParam)}`;
    const box = document.createElement('div');
    box.className = 'news_box';
    if (mobile) {
      const time = document.createElement('span');
      time.className = 'news_time';
      time.textContent = formatDate(item.create_time);
      box.append(time);
    }
    const title = document.createElement('span');
    title.className = 'news_title';
    const heading = document.createElement('h2');
    heading.textContent = item.title || '';
    title.append(heading);
    const text = document.createElement('span');
    text.className = 'news_text';
    text.textContent = item.intro || item.desc || '';
    const more = document.createElement('span');
    more.className = 'news_more';
    more.textContent = '查看更多';
    box.append(title, text, more);
    const photo = document.createElement('div');
    photo.className = 'news_photo';
    const image = document.createElement('img');
    image.src = imageFor(item);
    image.alt = item.title || '';
    image.loading = 'lazy';
    photo.append(image);
    link.append(box, photo);
    li.append(link);
    return li;
  }

  function renderList(list, items, mobile) {
    if (!list) return;
    list.replaceChildren();
    if (!items.length) {
      const empty = document.createElement('li');
      empty.className = 'jzt2-empty';
      empty.textContent = '暂无新闻内容';
      list.append(empty);
      return;
    }
    items.forEach(item => list.append(createNewsItem(item, mobile)));
  }

  function renderPagination(lastPage) {
    if (!pagination) return;
    pagination.replaceChildren();
    const addLink = (label, page, disabled = false) => {
      const link = document.createElement('a');
      link.textContent = label;
      if (!disabled) {
        const query = new URLSearchParams();
        query.set('page', String(page));
        if (categoryParam) query.set('category_id', categoryParam);
        if (sortParam) query.set('sort', sortParam);
        link.href = `/news/?${query.toString()}`;
      }
      if (page === currentPage && label !== '上一页' && label !== '下一页') {
        link.className = 'select';
        link.setAttribute('aria-current', 'page');
      }
      pagination.append(link);
    };
    addLink('上一页', currentPage - 1, currentPage <= 1);
    const visibleCount = Math.min(5, lastPage);
    let start = Math.max(1, currentPage - Math.floor(visibleCount / 2));
    const end = Math.min(lastPage, start + visibleCount - 1);
    start = Math.max(1, end - visibleCount + 1);
    for (let index = start; index <= end; index += 1) addLink(String(index), index);
    addLink('下一页', currentPage + 1, currentPage >= lastPage);
    const summary = document.createTextNode(`当前${currentPage}/${lastPage}页   共${lastPage}页`);
    pagination.append(summary);
    pagination.hidden = lastPage <= 1;
  }

  const filtered = categoryParam ? sortedNews.filter(item => categoryMatch(item, categoryParam)) : sortedNews;
  const lastPage = Math.max(1, Math.ceil(filtered.length / pageSize));
  currentPage = Math.min(currentPage, lastPage);
  const visible = filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize);
  renderList(desktopList, visible, false);
  renderList(mobileList, visible, true);
  renderPagination(lastPage);
  categoryItems.forEach(item => item.classList.toggle('tech_current', item.dataset.categoryId === categoryParam));
</script>
