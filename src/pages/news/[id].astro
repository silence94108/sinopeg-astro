---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../layouts/PageBanner.astro';
import TechSidebar from '../../components/TechSidebar.astro';
import { getJsonData, requestData, rewriteProductLinks } from '../../lib/utils';

const NEWS_PARENT_ID = '6a180222b3bb1862a238ca68';

export function getStaticPaths() {
  return requestData('news').map((item: any) => ({
    params: { id: String(item.id) },
    props: { summary: item }
  }));
}

const { id } = Astro.params;
const summary = Astro.props.summary || {};
let item = summary;

try {
  item = getJsonData(`content/${id}`);
} catch {
  item = summary;
}

const categories = requestData('category', {
  data_type: 'list',
  limit: -1,
  sort: 'sortAsc',
  type: 'content',
  category_id: NEWS_PARENT_ID,
  list_type: 'children'
});
const categoryIds = String(item.category_id || '')
  .split(',')
  .map((categoryId) => categoryId.trim())
  .filter(Boolean);
const currentCategory = categories.find((category: any) => categoryIds.includes(String(category.id))) || {};
const currentCategoryId = String(currentCategory.id || categoryIds[0] || '');
const parentCategory = requestData('category', { data_type: 'show', id: NEWS_PARENT_ID }).info || {};
const banner = parentCategory.image_intro || '/images/bg7.png';
const sort = Astro.url.searchParams.get('sort') === 'sortAsc' ? 'sortAsc' : 'sortDesc';
const allNews = requestData('news', { data_type: 'list', limit: -1, sort });
const categoryNews = currentCategoryId
  ? allNews.filter((entry: any) => String(entry.category_id || '').split(',').includes(currentCategoryId))
  : allNews;
const currentIndex = categoryNews.findIndex((entry: any) => String(entry.id) === String(id));
const up = currentIndex > 0 ? categoryNews[currentIndex - 1] : null;
const down = currentIndex >= 0 && currentIndex < categoryNews.length - 1 ? categoryNews[currentIndex + 1] : null;
const recommendNews = allNews
  .filter((entry: any) => entry.recommend === true || String(entry.recommend) === '1')
  .slice(0, 8);
// 左栏分类链接与面包屑：原站不带 sort
const categoryListLink = currentCategoryId
  ? `/news/?category_id=${encodeURIComponent(currentCategoryId)}`
  : '/news/';
// 详情链接用条目自身的 category_id（原站模板写法），而不是拆分后的第一个分类
const newsLink = (entry: any) => {
  const categoryId = String(entry.category_id || '') || currentCategoryId;
  return `/news/${entry.id}/?category_id=${encodeURIComponent(categoryId)}&sort=${sort}`;
};

// 上下篇由地址栏的 category_id / sort 决定，静态页构建期拿不到 query，改由客户端按同一规则重算
const sortNewsBy = (list: any[], sortKey: string) => {
  const compare = (a: any, b: any) => sortKey === 'sortAsc'
    ? Number(a.sort || 0) - Number(b.sort || 0)
    : Number(b.sort || 0) - Number(a.sort || 0);
  return [
    ...list.filter((entry: any) => entry.is_top == 1).sort(compare),
    ...list.filter((entry: any) => entry.is_top != 1).sort(compare),
  ];
};
const neighborKeys = [...new Set([String(item.category_id || ''), ...categoryIds].filter(Boolean))];
const neighborByKey = Object.fromEntries(
  neighborKeys.flatMap((key) => {
    const keyIds = key.split(',').map((value) => value.trim()).filter(Boolean);
    return ['sortAsc', 'sortDesc'].map((sortKey) => {
      const list = sortNewsBy(allNews, sortKey).filter((entry: any) =>
        String(entry.category_id || '')
          .split(',')
          .map((value) => value.trim())
          .some((entryCategoryId) => keyIds.includes(entryCategoryId)),
      );
      const index = list.findIndex((entry: any) => String(entry.id) === String(id));
      const toLink = (entry: any) => entry
        ? {
            id: String(entry.id),
            title: String(entry.title || ''),
            categoryId: String(entry.category_id || ''),
          }
        : null;
      return [`${sortKey}|${key}`, {
        up: index > 0 ? toLink(list[index - 1]) : null,
        down: index >= 0 && index < list.length - 1 ? toLink(list[index + 1]) : null,
      }];
    });
  }),
);

const crumbs = [
  { name: '新闻', link: '/news/' },
  ...(currentCategory.title ? [{ name: currentCategory.title, link: categoryListLink }] : []),
  { name: item.title || '详情' }
];
---

<BaseLayout tdk={{ title: item.webTitle || `${item.title || '新闻'} - 赛诺邦格`, keywords: item.webKey || '', description: item.webDesc || item.intro || '' }}>
  <PageBanner bannerImage={banner} titleZh="新闻" titleEn="News" crumbs={crumbs} />
  <div class="project_section">
    <img src="/images/bg7.png" class="pro_bg1" alt="" />
    <div class="block">
      <div class="proj_bg"></div>
      <div class="inner clearfix">
        <aside class="left">
          <span class="left_caption sp">新闻</span>
          <ul class="tech_list">
            {categories.map((category: any) => (
              <li data-category-id={category.id} class={`tech_item${String(category.id) === currentCategoryId ? ' tech_current' : ''}`}>
                <a href={`/news/?category_id=${encodeURIComponent(category.id)}`} class="tech_link">{category.title}</a>
              </li>
            ))}
            {!categories.length && <li class="jzt2-empty">暂无新闻分类</li>}
          </ul>
          <div class="pc1"><TechSidebar /></div>
        </aside>

        <section class="right right1">
          <div class="content_wrapper">
            <div class="main_content">
              <a href={categoryListLink} class="news_ex_return" onclick="history.back(-1)">返回</a>
              {item.id ? (
                <div class="tech_box news_ex_section jzt2-richtext" set:html={rewriteProductLinks(item.details || item.content || item.intro || '')}></div>
              ) : <div class="jzt2-empty">暂无新闻内容</div>}
              {(up || down) && (
                <div
                  class="ex news_ex_section"
                  data-news-neighbors={JSON.stringify(neighborByKey)}
                  data-news-detail-category={String(item.category_id || '')}
                >
                  <a
                    href={up ? newsLink(up) : '#'}
                    class="ex_link"
                    data-news-neighbor="up"
                    hidden={!up}
                  >上一篇 {up?.title}</a>
                  <a
                    href={down ? newsLink(down) : '#'}
                    class="ex_link"
                    data-news-neighbor="down"
                    hidden={!down}
                  >下一篇 {down?.title}</a>
                </div>
              )}
            </div>

            <aside class="sidebar_content">
              <div class="right_recommend">
                <div class="right_recommend_title">相关推荐</div>
                {recommendNews.length ? (
                  <ul class="right_recommend_list">
                    {recommendNews.map((entry: any) => (
                      <li class="right_recommend_item">
                        <a href={newsLink(entry)} class="right_recommend_link">{entry.title}</a>
                      </li>
                    ))}
                  </ul>
                ) : <div class="jzt2-empty">暂无推荐新闻</div>}
              </div>
            </aside>
          </div>
        </section>

        <div class="sp"><TechSidebar /></div>
        <div class="blank50"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // 上下篇 / 左栏高亮与原站一致：由地址栏 category_id、sort 决定
  const neighborsHost = document.querySelector<HTMLElement>("[data-news-neighbors]");
  if (neighborsHost) {
    const params = new URLSearchParams(window.location.search);
    const sortKey = params.get("sort") === "sortAsc" ? "sortAsc" : "sortDesc";
    const requestedCategory = params.get("category_id") || "";
    const detailCategory = neighborsHost.dataset.newsDetailCategory || "";
    const map: Record<string, any> = JSON.parse(neighborsHost.dataset.newsNeighbors || "{}");

    // 原站用地址栏 category_id；没有则退回详情自身的 category_id（可能含多个，精确匹配即不命中）
    const neighbors = map[`${sortKey}|${requestedCategory}`] || map[`${sortKey}|${detailCategory}`];
    (["up", "down"] as const).forEach((direction) => {
      const link = neighborsHost.querySelector<HTMLAnchorElement>(
        `[data-news-neighbor="${direction}"]`,
      );
      if (!link) return;
      const entry = neighbors ? neighbors[direction] : null;
      link.hidden = !entry;
      if (!entry) return;
      const query = new URLSearchParams();
      if (entry.categoryId) query.set("category_id", entry.categoryId);
      query.set("sort", sortKey);
      link.href = `/news/${entry.id}/?${query.toString()}`;
      link.textContent = `${direction === "up" ? "上一篇" : "下一篇"} ${entry.title}`;
    });

    const activeCategory = requestedCategory || detailCategory;
    document.querySelectorAll<HTMLElement>(".tech_item[data-category-id]").forEach((item) => {
      item.classList.toggle("tech_current", item.dataset.categoryId === activeCategory);
    });

    // 同页其它新闻详情链接（相关推荐等）同步带上当前 sort，避免落到默认 sortDesc
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/news/"]').forEach((link) => {
      const href = link.getAttribute("href") || "";
      if (!/^\/news\/[^/?]+\//.test(href)) return;
      const url = new URL(href, window.location.origin);
      if (!url.searchParams.has("category_id")) return;
      url.searchParams.set("sort", sortKey);
      link.setAttribute("href", `${url.pathname}?${url.searchParams.toString()}`);
    });
  }
</script>

<style>
  .content_wrapper { display: flex; gap: 20px; align-items: flex-start; }
  .main_content { flex: 1; min-width: 0; }
  .sidebar_content { width: 300px; flex-shrink: 0; position: absolute; right: -25%; }
  .right_recommend { background: #f9f9f9; border-radius: 5px; padding: 20px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05); margin-bottom: 20px; }
  .right_recommend_title { font-size: 18px; color: #333; border-bottom: 2px solid #1e6ba3; padding-bottom: 10px; margin-bottom: 15px; font-weight: bold; }
  .right_recommend_list { list-style: none; padding: 0; margin: 0; }
  .right_recommend_item { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px dashed #e0e0e0; }
  .right_recommend_item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
  .right_recommend_link { display: block; color: #555; text-decoration: none; line-height: 1.5; transition: color 0.3s; position: relative; padding-left: 15px; }
  .right_recommend_link::before { content: '•'; position: absolute; left: 0; color: #1e6ba3; }
  .right_recommend_link:hover { color: #1e6ba3; }
  .news_ex_section :global(h1) { font-size: 2em; line-height: 1.5; }
  .news_ex_section :global(h2) { font-size: 1.5em; line-height: 1.5; }
  .news_ex_section :global(h3) { font-size: 1.17em; line-height: 1.5; }
  .news_ex_section :global(img) { max-width: 100%; height: auto; }
  .ex { display: flex; flex-direction: column; align-items: flex-start; }

  @media (max-width: 768px) {
    .content_wrapper { flex-direction: column; }
    .sidebar_content { width: 100%; position: static; }
    .right_recommend { margin-top: 20px; padding: 15px; }
    .right_recommend_title { font-size: 16px; }
    .right_recommend_link { font-size: 14px; }
  }
</style>
