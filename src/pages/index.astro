---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBanner from '../components/HomeBanner.astro';
import { requestData } from '../lib/utils';

const tdk = {
  title: '首页 - 厦门赛诺邦格生物科技|化合物定制合成_聚乙二醇衍生物/脂质/LNP供应商',
  description: '聚乙二醇衍生物, peg化脂质, LNP递送, siRNA靶向修饰,嵌段共聚物, 药物递送系统(DDS)',
  keywords: '厦门赛诺邦格生物科技股份有限公司专注于药物递送系统（DDS）及高端医用材料研发，提供聚乙二醇衍生物（单/多分散）、peg化脂质、LNP递送等产品，应用于mRNA疫苗、小核酸药物、长效蛋白药及基因治疗领域。'
}

// 产品中心
const PRODUCT_PARENT_ID = "6a16ba87f7cca976d042d56a";
const goodsCategories = requestData("category", {
	data_type: "list",
	limit: 8,
	sort: "sortAsc",
	type: "goods",
	category_id: PRODUCT_PARENT_ID,
	isIndex: false
})
const proListClass = () => {
	const base = goodsCategories.length;
	console.log(base);
	const total = (base === 5 || base === 7) ? base + 1 : base;
	if (total === 4 || total === 7 || total === 8) return "index_pro_list1";
	if (total === 3 || total === 5 || total === 6) return "index_pro_list2";
	return "";
}

// 技术
const techList = requestData("technology", {
	page: 1,
	limit: 4,
	data_type: "list"
});
const currentTechIndex = 0;

// 服务
const serviceList = requestData("service", {
	data_type: "list",
	limit: 2,
	sort: "sortDesc"
});

// 新闻
const newsList = requestData("news", {
	data_type: "list",
	page: 1,
	limit: 3,
	sort: "sortDesc",
	recommend: true
});

// 合作
const COOPERATION_CATEGORY_ID = "6a22243737509051865330ed";
const cooperationList = requestData("images", {
	data_type: "list",
	limit: -1,
	sort: "sortDesc",
	category_id: COOPERATION_CATEGORY_ID
})
            
// 关于我们
const ABOUT_INFO_ID = "6a1e75a110b5fc178d494b8b";
const aboutRes = requestData("contact", {
	data_type: "show",
	id: ABOUT_INFO_ID
})
const aboutInfo = aboutRes && aboutRes.info

// 站点信息
const siteInfo = requestData("site")
---

<BaseLayout tdk={tdk}>
	<HomeBanner />
	<!-- 产品中心 -->
	<div class="index_pro">
		<div class="inner">
			<div class="index_pro_title">
				<span class="index_pro_en">Products</span>
				<h2 class="index_pro_zh">产品中心</h2>
			</div>
			<ul class={`index_pro_list clearfix ${proListClass()}`}>
				{goodsCategories.map((item: any) => (
					<li class="index_pro_item">
						<a href={`project.html?category_id=${item.id}`} class="index_pro_link">
							<div class="index_pro_photo"><img src={item.image_intro || 'images/g2.png'} alt="item.title" /></div>
							<h3 class="index_pro_name">{ item.title }</h3>
						</a>
					</li>
				))}
				{goodsCategories.length === 5 || goodsCategories.length === 7 && (
					<li class="index_pro_item">
						<a href="#" class="index_pro_link">
							<div class="index_pro_photo"><img src="images/g2.png" alt="产品研发中" /></div>
							<h3 class="index_pro_name">产品研发中...</h3>
						</a>
					</li>
				)}
				{!goodsCategories.length && (<li class="jzt2-empty">暂无产品分类</li>)}
			</ul>
			<a href="project.html" class="index_pro_more">
				<span>查看更多</span>
				<img src="images/jian4.png" class="index_pro_show" />
				<img src="images/jian2.png" class="index_pro_hide" />
			</a>
		</div>
	</div>
	<!-- 技术 -->
	<div class="index_tech">
		<div class="inner">
			<div class="index_tech_title">
				<span class="index_pro_en">Technology</span>
				<h2 class="index_pro_zh">技术</h2>
			</div>
			<div class="index_tech_right spb">
				{techList.map((item: any, index: number) => (
					<div class={`index_tech_item ${index === currentTechIndex ? 'index_tech_current' : ''}`} onclick="setCurrentTech(index)">
						<div class="index_tech_info">
							<img src="images/tech2.png" />
							<h3 class="index_tech_caption">{ item.title }</h3>
							<img src="images/tech1.png" class="index_tech_biao" />
						</div>
					</div>
				))}
			</div>
			<div class="index_tech_section">
				<img src="images/g16.png" class="index_tech_bg" />
				<div class="index_tech_block">
					{techList.map((item: any, index: number) => (
						<div class="index_tech_area" v-if="index === currentTechIndex">
							<div class="index_tech_box">
								<a href={`'tech.html?id=${item.id}&category_id=${item.category_id}`}
									class="index_tech_photo">
									<img src={item.bg_img || 'images/tech1.png'} alt={item.title} />
								</a>
							</div>
							<h3 class="index_tech_name">{ item.title }</h3>
							<span class="index_tech_text">{ item.intro || item.desc }</span>
						</div>
					))}
					{!techList.length && (<div class="jzt2-empty">暂无技术内容</div>)}
				</div>
				<div class="index_tech_right pc">
					{techList.map((item: any, index: number) => (
					<div class={`index_tech_item ${index === currentTechIndex ? 'index_tech_current' : ''}`} onclick="setCurrentTech(index)">
						<div class="index_tech_info">
							<img src="images/tech2.png" />
							<h3 class="index_tech_caption">{ item.title }</h3>
							<img src="images/tech1.png" class="index_tech_biao" />
						</div>
					</div>
					))}
				</div>
			</div>
		</div>
	</div>
	<!-- 服务 -->
	<div class="index_service">
		<div class="inner">
			<div class="index_service_section">
				<div class="index_service_title">
					<span class="index_pro_en">Service</span>
					<h2 class="index_pro_zh">服务</h2>
				</div>
				<ul class="index_service_list">
					{serviceList.map((item: any) => (
						<li class="index_service_item">
							<a href={`service.html?id=${item.id}&category_id=${item.category_id}`} class="index_service_link">
								<div class="index_service_left">
									<img src={item.bg_img} />
									<h3>{ item.title }</h3>
								</div>
								<div class="index_service_right">
									<span>查看更多</span>
									<img src="images/jian4.png" />
								</div>
								<img src="images/kuang1.png" class="index_service_bg1" />
								<img src="images/kuang2.png" class="index_service_bg2" />
							</a>
						</li>
					))}
					{!serviceList.length && (<li class="jzt2-empty">暂无服务内容</li>)}
				</ul>
			</div>
		</div>
	</div>
	<!-- 新闻 -->
	<div class="index_news">
		<div class="inner">
			<div class="index_pro_title">
				<span class="index_pro_en">News</span>
				<h2 class="index_pro_zh">新闻</h2>
			</div>
			<ul class="index_news_list">
				{newsList.map((item: any) => (
					<li class="index_news_item">
						<a href={`news_ex.html?id=${item.id}&category_id=${item.category_id}&sort=sortAsc`} class="index_news_link">
							<img src={item.bg_img || 'images/news1.png'} alt={item.title} />
							<div class="index_news_box">
								<h3 class="index_news_title">{ item.title }</h3>
								<span class="index_news_text">{ item.intro }</span>
							</div>
							<div class="index_news_time">
								<span>{ item.create_time }</span>
								<img src="images/jian1.png" />
							</div>
						</a>
					</li>
				))}
				{!newsList.length && (<li class="jzt2-empty">暂无新闻内容</li>)}
			</ul>
			<a href="news.html" class="index_pro_more">
				<span>查看更多</span>
				<img src="images/jian4.png" class="index_pro_show" />
				<img src="images/jian2.png" class="index_pro_hide" />
			</a>
		</div>
	</div>
	<!-- 合作 -->
	<div class="index_hezuo">
		<div class="inner">
			<div class="index_hezuo_title">
				<span class="index_pro_en">COLLABORATION</span>
				<h2 class="index_pro_zh">合作</h2>
			</div>
			{cooperationList.length && (
				 <div class="index_hezuo_banner">
					<div class="swiper swiper-container gallery-thumbs cooperation-thumbs">
						<div class="swiper-wrapper">
							{cooperationList.map((item: any) => (
								<div class="swiper-slide">
									<img src={item.bg_img} alt={item.title} />
								</div>
							))}
						</div>

						<div class="index_hezuo_info">
							<div class="swiper-pagination cooperation-pagination"></div>
							<div class="swiper-button-next cooperation-next"></div>
							<div class="swiper-button-prev cooperation-prev"></div>
						</div>
					</div>

					<div class="swiper swiper-container gallery-top cooperation-content">
						<div class="swiper-wrapper">
							{cooperationList.map((item: any) => (
								<div class="swiper-slide">
									<div class="index_hezuo_right clearfix">
										<h3 class="index_hezuo_name">{item.title}</h3>
										<span class="index_hezuo_caption">——{item.intro}</span>
										<img src="images/ju1.png" class="index_hezuo_bg1" alt="" />
										<span class="index_hezuo_text" set:html={item.details}></span>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			)}
			{!cooperationList.length && (<div class="jzt2-empty">暂无合作内容</div>)}
		</div>
	</div>
	<!-- 关于我们 -->
	<div class="index_about">
		<div class="index_about_title index_aboutsp">
			<span class="index_pro_en">{ aboutInfo.intro || "About" }</span>
			<h2 class="index_pro_zh">{ aboutInfo.title || "关于我们" }</h2>
		</div>
		<div class="inner">
			<div class="index_about_left">
				<div class="index_about_title index_aboutpc">
					<span class="index_pro_en">{ aboutInfo.intro || "About" }</span>
					<h3 class="index_pro_zh">{ aboutInfo.title || "关于我们" }</h3>
				</div>
				<h3 class="index_about_name">{ siteInfo.company_title || "厦门赛诺邦格生物科技股份有限公司" }</h3>
				<span class="index_about_text" set:html={aboutInfo.details}></span>
				<a href="contact.html" class="index_pro_more index_aboutpc">
					<span>查看更多</span>
					<img src="images/jian4.png" class="index_pro_show" />
					<img src="images/jian2.png" class="index_pro_hide" />
				</a>
			</div>
		</div>
		<a href="contact.html" class="index_pro_more index_aboutsp">
			<span>查看更多</span>
			<img src="images/jian4.png" class="index_pro_show" />
			<img src="images/jian2.png" class="index_pro_hide" />
		</a>
	</div>
	<script>
		import Swiper from 'swiper';
		import {
			FreeMode,
			Grid,
			Navigation,
			Pagination,
			Thumbs,
		} from 'swiper/modules';

		import 'swiper/css';
		import 'swiper/css/grid';
		import 'swiper/css/navigation';
		import 'swiper/css/pagination';
		import 'swiper/css/free-mode';

		const thumbsSwiper = new Swiper('.cooperation-thumbs', {
			modules: [FreeMode, Grid, Navigation, Pagination],
			slidesPerView: 3,
			grid: {
				rows: 2,
				fill: 'column',
			},
			spaceBetween: 10,
			freeMode: true,
			watchSlidesProgress: true,
			navigation: {
				nextEl: '.cooperation-next',
				prevEl: '.cooperation-prev',
			},
			pagination: {
				el: '.cooperation-pagination',
				type: 'fraction',
			},
			breakpoints: {
				1000: {
					slidesPerView: 2,
					grid: {
						rows: 3,
						fill: 'column',
					},
				},
			},
		});

		new Swiper('.cooperation-content', {
			modules: [Thumbs],
			autoHeight: true,
			thumbs: {
				swiper: thumbsSwiper,
			},
		});
	</script>
</BaseLayout>