---
const { layout, caption } = Astro.props;
const inline = layout === "inline";
const formClass = inline ? "con_section clearfix" : "liu_form";
const infoClass = inline ? "con_info" : "liu_info";
const buttonClass = inline ? "proex_form_btu" : "liu_btu";
---

<form class={formClass} action="/api/submit" method="post" data-message-form>
  {caption && <span class="liu_caption">{caption}</span>}
  <div class={inline ? "con_block" : undefined}>
    <div class={infoClass}>
      <img src="/images/liu1.png" alt="单位" />
      <input type="text" name="company" placeholder="单位" autocomplete="organization" />
    </div>
    <div class={infoClass}>
      <img src="/images/liu3.png" alt="联系电话" />
      <input type="tel" name="phone" placeholder="联系电话" autocomplete="tel" />
    </div>
    <div class={infoClass}>
      <img src="/images/liu2.png" alt="电子邮箱" />
      <span class="liu_required">*</span>
      <input type="email" name="email" placeholder="电子邮箱" autocomplete="email" required />
    </div>
  </div>

  <div class={inline ? "con_block" : undefined}>
    <div class={infoClass}>
      <img src="/images/liu4.png" alt="留言" />
      <span class="liu_required">*</span>
      <textarea name="content" placeholder="您的留言" autocomplete="off" required></textarea>
    </div>
  </div>

  <button type="submit" class={buttonClass}>提交留言</button>
  <p class="message_form_status" data-message-status aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-message-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("[type=submit]");
      const status = form.querySelector<HTMLElement>("[data-message-status]");
      if (button) button.disabled = true;
      if (status) status.textContent = "提交中...";

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
        });
        if (!response.ok) throw new Error("submit failed");
        form.reset();
        if (status) status.textContent = "提交成功";
      } catch {
        if (status) status.textContent = "提交失败，请稍后再试";
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
