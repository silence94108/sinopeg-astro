        />
      </form>
      <div class="laji" style="position: absolute; right: 0; top: 77%; width: 25%; border-radius: 10px;">
        <ul
          id="search_list2"
          v-show="pcSuggestionsVisible && pcSuggestions.length"
          style="display: block; border: 1px solid #1459A8; background: #EBEBEB; padding: 20px; border-radius: 10px;"
        >
          <li
            v-for="item in pcSuggestions"
            :key="'pc-' + item"
            style="font-size: 14px; cursor: pointer;"
            @mousedown.prevent="selectSuggestion(item)"
          >{{ item }}</li>
        </ul>
      </div> -->
    </div>
  </div>
</div>
