---
import { requestData } from "../lib/utils";

const siteInfo = requestData("site");

const logoSrc = (siteInfo && siteInfo.pc_logo) || "/images/logo.png";
const logoAlt = (siteInfo && siteInfo.title) || "Logo";

const menuList: any = requestData("nav", {
  sort: "sortAsc",
  data_type: "list",
}); // 导航菜单

const isProductNav = (item: any) => {
  if (!item) return false;
  return item.title === "产品" || /project\.html/.test(item.link || "");
};

const PRODUCT_PARENT_ID = "6a16ba87f7cca976d042d56a";
const categories: any = requestData("category", {
  data_type: "list",
  limit: -1,
  sort: "sortAsc",
  type: "goods",
  isNav: false,
}); // 产品分类
const rootCategories: any = categories.filter((item: any) => item.pid === PRODUCT_PARENT_ID); // 产品分类
const getChildren = (pid: any) => categories.filter((c: any) => c.pid === pid);
const hasChildren = (id: any) => getChildren(id).length > 0;

const getListLink = (id: string, parentId: string, rootId: string = "") => {
  let link = `prolist.html?category_id=${id}`;
  if (parentId) link += `&parent_id=${parentId}`;
  if (rootId) link += `&root_id=${rootId}`;
  return link;
};

const pcSuggestion: any = [];
---

<div class="header">
  <div class="inner">
    <div class="logo">
      <h2><a href="/"><img src={logoSrc} alt={logoAlt} /></a></h2>
    </div>
    <div class="header_right">
      <ul class="nav_list clearfix">
        {
          menuList.map((item: any) => (
            <li
              class="nav_item"
              @mouseenter="isProductNav(item) ? onMegaEnter($event) : null"
              @mouseleave="isProductNav(item) ? onMegaLeave($event) : null"
            >
              <a
                href={
                  item.link && item.link.replace("./", "/").replace(".html", "")
                }
                class="nav_link"
                target={item.target ? "_blank" : null}
                rel={item.target ? "noopener noreferrer nofollow" : null}
              >
                {item.title}
              </a>
              {isProductNav(item) && rootCategories.length > 0 && (
                <div
                  class="nav_mega"
                  @mouseenter="onMegaEnter($event.currentTarget.closest('.nav_item'))"
                  @mouseleave="onMegaLeave($event.currentTarget.closest('.nav_item'))"
                >
                  <div class="nav_mega_inner">
                    {rootCategories.map((root: any) => (
                      <div class="nav_mega_group">
                        <a
                          href={`/project/?category_id=${root.id}`}
                          class="nav_mega_title"
                        >
                          {root.title}
                        </a>
                        {hasChildren(root.id) && (
                          <div class="nav_mega_children">
                            {getChildren(root.id).map((child: any) => (
                              <div class="nav_mega_child_group">
                                <a
                                  href={getListLink(child.id, root.id)}
                                  class="nav_mega_child_title"
                                >
                                  {child.title}
                                </a>
                                {hasChildren(child.id) && (
                                  <div class="nav_mega_grand_list">
                                    {getChildren(child.id).map((grand: any) => (
                                      <a
                                        href={getListLink(
                                          grand.id,
                                          child.id,
                                          root.id,
                                        )}
                                        class="nav_mega_grand_child"
                                      >
                                        {grand.title}
                                      </a>
                                    ))}
                                  </div>
                                )}
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
      <a href="https://www.sinopeg.com/" class="en" target="_blank">
        <img src="images/en.png" />
      </a>
      <form class="header_form" @submit.prevent="submitSearch">
        <input type="button" class="header_form_btu" @click="submitSearch" />
        <input
          type="text"
          class="header_form_input"
          autocomplete="off"
          v-model="keyword"
          placeholder="关键词搜索"
          @input="updatePcSuggestions"
          @focus="updatePcSuggestions"
          @blur="hidePcSuggestions"
        />
      </form>
      <div
        class="laji"
        style="position: absolute; right: 0; top: 77%; width: 25%; border-radius: 10px;"
      >
        <ul
          id="search_list2"
          style="display: none; border: 1px solid #1459A8; background: #EBEBEB; padding: 20px; border-radius: 10px;"
        >
          {
            pcSuggestion.map((item: any) => (
              <li
                style="font-size: 14px; cursor: pointer;"
                @mousedown.prevent="selectSuggestion(item)"
              >
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>
