---
import { requestData } from "../lib/utils";

const siteInfo = requestData("site");

const logoSrc = (siteInfo && siteInfo.pc_logo) || "/images/logo.png";
const logoAlt = (siteInfo && siteInfo.title) || "Logo";
const searchPath = `${import.meta.env.BASE_URL}search/`;

const menuList: any = requestData("nav", {
  sort: "sortAsc",
  data_type: "list",
}); // 导航菜单

const isProductNav = (item: any) => {
  if (!item) return false;
  return item.title === "产品" || /project\.html/.test(item.link || "");
};
const getNavLink = (item: any) => {
  if (isProductNav(item)) return "/project/";
  return item.link && item.link.replace("./", "/").replace(".html", "");
};

const PRODUCT_PARENT_ID = "6a16ba87f7cca976d042d56a";
const categories: any = requestData("category", {
  data_type: "list",
  limit: -1,
  sort: "sortAsc",
  type: "goods",
  isNav: false,
}); // 产品分类
const rootCategories: any = categories.filter((item: any) => item.pid === PRODUCT_PARENT_ID); // 产品分类
const getChildren = (pid: any) => categories.filter((c: any) => c.pid === pid);
const hasChildren = (id: any) => getChildren(id).length > 0;

const getListLink = (id: string) => `/project/${id}/`;

---

<div class="header">
  <div class="inner">
    <div class="logo">
      <h2><a href="/"><img src={logoSrc} alt={logoAlt} /></a></h2>
    </div>
    <div class="header_right">
      <ul class="nav_list clearfix">
        {
          menuList.map((item: any) => (
            <li
              class="nav_item"
              @mouseenter="isProductNav(item) ? onMegaEnter($event) : null"
              @mouseleave="isProductNav(item) ? onMegaLeave($event) : null"
            >
              <a
                href={getNavLink(item)}
                class="nav_link"
                target={item.target ? "_blank" : null}
                rel={item.target ? "noopener noreferrer nofollow" : null}
              >
                {item.title}
              </a>
              {isProductNav(item) && rootCategories.length > 0 && (
                <div
                  class="nav_mega"
                  @mouseenter="onMegaEnter($event.currentTarget.closest('.nav_item'))"
                  @mouseleave="onMegaLeave($event.currentTarget.closest('.nav_item'))"
                >
                  <div class="nav_mega_inner">
                    {rootCategories.map((root: any) => (
                      <div class="nav_mega_group">
                        <a
                          href={`/project/${root.id}/`}
                          class="nav_mega_title"
                        >
                          {root.title}
                        </a>
                        {hasChildren(root.id) && (
                          <div class="nav_mega_children">
                            {getChildren(root.id).map((child: any) => (
                              <div class="nav_mega_child_group">
                                <a
                                  href={getListLink(child.id)}
                                  class="nav_mega_child_title"
                                >
                                  {child.title}
                                </a>
                                {hasChildren(child.id) && (
                                  <div class="nav_mega_grand_list">
                                    {getChildren(child.id).map((grand: any) => (
                                      <a
                                        href={getListLink(grand.id)}
                                        class="nav_mega_grand_child"
                                      >
                                        {grand.title}
                                      </a>
                                    ))}
                                  </div>
                                )}
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
      <a href="https://www.sinopeg.com/" class="en" target="_blank">
        <img src="/images/en.png" />
      </a>
      <!-- Header 和 Banner 使用同一套产品搜索逻辑，表单本身保留原生 GET 兜底。 -->
      <form class="header_form" action={searchPath} method="get" data-header-search-form>
        <input type="submit" value="" class="header_form_btu" aria-label="搜索" />
        <input
          type="text"
          name="key"
          class="header_form_input"
          autocomplete="off"
          placeholder="关键词搜索"
          aria-controls="search_list2"
          aria-expanded="false"
          data-header-search-input
        />
      </form>
      <div
        class="laji"
        style="position: absolute; right: 0; top: 77%; width: 25%; border-radius: 10px;"
      >
        <ul
          id="search_list2"
          hidden
          style="border: 1px solid #1459A8; background: #EBEBEB; padding: 20px; border-radius: 10px;"
          data-header-search-list
        ></ul>
      </div>
    </div>
  </div>
</div>
<div class="blank80"></div>
<div class="header_sp">
  <div class="inner">
    <div class="header_sp_section">
      <div class="logo"><a href="/"><img src={logoSrc} alt={logoAlt} /></a></div>
      <a href="https://www.sinopeg.com/" class="en" target="_blank" rel="noopener noreferrer"><img src="/images/en.png" alt="English" /></a>
      <form class="header_form" action={searchPath} method="get">
        <input type="text" name="key" class="header_form_input" placeholder="关键词搜索" />
        <input type="submit" class="header_form_btu" value="" aria-label="搜索" />
      </form>
    </div>
    <button class="header_menu" type="button" aria-expanded="false"><span>菜单</span><img src="/images/nav1.png" alt="Menu" /></button>
    <ul class="menu_list">
      {menuList.map((item: any) => (
        <li class="menu_item">
          {isProductNav(item) && rootCategories.length > 0 ? (
            <>
              <div class="menu_link menu_link1">
                <a href={getNavLink(item)}>{item.title}</a>
                <button type="button" class="menu_jia" aria-label="展开产品分类" aria-expanded="false">+</button>
                <button type="button" class="menu_jian" aria-label="收起产品分类" aria-expanded="true">-</button>
              </div>
              <div class="menu_er">
                {rootCategories.map((root: any) => (
                  <div class="menu_area">
                    <div class="menu_link menu_link2">
                      <a href={`/project/${root.id}/`}>{root.title}</a>
                      {hasChildren(root.id) && <><button type="button" class="menu_jia" aria-label={`展开${root.title}`} aria-expanded="false">+</button><button type="button" class="menu_jian" aria-label={`收起${root.title}`} aria-expanded="true">-</button></>}
                    </div>
                    {hasChildren(root.id) && <ul class="menu_er_list">
                      {getChildren(root.id).map((child: any) => (
                        hasChildren(child.id) ? (
                          <li class="menu_er_item">
                            <div class="menu_link menu_link3">
                              <a href={getListLink(child.id)}>{child.title}</a>
                              <button type="button" class="menu_jia" aria-label={`展开${child.title}`} aria-expanded="false">+</button><button type="button" class="menu_jian" aria-label={`收起${child.title}`} aria-expanded="true">-</button>
                            </div>
                            <ul class="menu_san_list">{getChildren(child.id).map((grand: any) => <li class="menu_san_item"><a href={getListLink(grand.id)} class="menu_san_link">{grand.title}</a></li>)}</ul>
                          </li>
                        ) : <li class="menu_san_item"><a href={getListLink(child.id)} class="menu_san_link">{child.title}</a></li>
                      ))}
                    </ul>}
                  </div>
                ))}
              </div>
            </>
          ) : <a href={getNavLink(item)} class="menu_link" target={item.target ? '_blank' : undefined} rel={item.target ? 'noopener noreferrer' : undefined}>{item.title}</a>}
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import { initProductSearch } from '../scripts/productSearch';

  // Header 只提供自己的 DOM 选择器，具体搜索行为由公共模块统一处理。
  initProductSearch({
    form: '[data-header-search-form]',
    input: '[data-header-search-input]',
    list: '[data-header-search-list]',
  });
</script>

<script>
  const mobileHeader = document.querySelector<HTMLElement>(".header_sp");
  const menuToggle = mobileHeader?.querySelector<HTMLElement>(".header_menu");
  const menuList = mobileHeader?.querySelector<HTMLElement>(".menu_list");
  menuToggle?.addEventListener("click", () => {
    if (!menuList) return;
    const isOpen = menuList.style.display === "block";
    menuList.style.display = isOpen ? "none" : "block";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
  });
  mobileHeader?.querySelectorAll<HTMLElement>(".menu_jia, .menu_jian").forEach((toggle) => {
    toggle.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const parent = toggle.closest<HTMLElement>(".menu_link");
      const next = parent?.nextElementSibling as HTMLElement | null;
      if (!next) return;
      const isOpen = next.style.display === "block";
      next.style.display = isOpen ? "none" : "block";
      if (parent?.classList.contains("menu_link2")) {
        parent.closest<HTMLElement>(".menu_area")?.classList.toggle("menu_current", !isOpen);
      } else if (parent?.classList.contains("menu_link3")) {
        parent.closest<HTMLElement>(".menu_er_item")?.classList.toggle("menu_er_current", !isOpen);
      } else {
        parent?.classList.toggle("menu1_current", !isOpen);
      }
      parent?.setAttribute("aria-expanded", String(!isOpen));
      parent?.querySelectorAll<HTMLElement>(".menu_jia, .menu_jian").forEach((button) => {
        button.setAttribute("aria-expanded", String(!isOpen));
      });
    });
  });
</script>
