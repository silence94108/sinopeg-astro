---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/StyleSheet.css';
import '../styles/swiper.min.css';
import '../styles/index.css';
import '../styles/search_list.css';
import { requestData } from '../lib/utils';

const { tdk } = Astro.props;

const siteInfo:any = requestData('site') || {}

const title = tdk && tdk.title || siteInfo.title
const keywords = tdk && tdk.keywords || siteInfo.keywords
const description = tdk && tdk.description || siteInfo.description
const ico = siteInfo.icon || '/images/favicon.ico'
---

<!DOCTYPE html>
<html>

<head>
  <title>{title}</title>
  <meta name="keywords" content={keywords} />
  <meta name="description" content={description} />
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href={ico} type="image/x-icon" rel="shortcut icon" />
  <script>
    import $ from 'jquery';
    import { submitStatistics } from '../scripts/analytics'

    Object.assign(window, { $, jQuery: $ });

    // @ts-expect-error 旧脚本仅用于执行副作用
    await import('../scripts/jquery.zoom.js');
    // @ts-expect-error 旧脚本仅用于执行副作用
    await import('../scripts/index.js');

    void submitStatistics()
  </script>
</head>

<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
